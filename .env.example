# Supabase — transaction-mode pooler (IPv4, app queries)
DATABASE_URL="postgresql://postgres.pjzkjfhuxfnvhdcrbznz:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — direct DB (migrations / Prisma migrate)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.pjzkjfhuxfnvhdcrbznz.supabase.co:5432/postgres"

PORT=3002
BASE_URL=http://localhost:3002
NODE_ENV=development
LOG_LEVEL=info

# Required for /api/v1/cart and /api/v1/checkout
API_KEY=change-me-to-a-long-secret

# JWT access (short-lived) + refresh sessions (long-lived)
JWT_ACCESS_SECRET=change-me-to-a-32-char-minimum-secret!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_ISSUER=shopping-cart
JWT_AUDIENCE=shopping-cart-api

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_WRITE_MAX=30

# Seed catalog + demo user on boot (default: true in development/test, false in production)
# SEED_ON_START=true

# Supabase Storage (S3-compatible) — product images
SUPABASE_URL=https://pjzkjfhuxfnvhdcrbznz.supabase.co
S3_ENDPOINT=https://pjzkjfhuxfnvhdcrbznz.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_BUCKET=product-images
# Create under Dashboard → Storage → S3 access keys (server-only)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upstash Redis (REST) — shared rate limits + product list cache
UPSTASH_REDIS_REST_URL=https://popular-troll-294499.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Soft stock holds for carts (seconds, default 900 = 15m)
STOCK_HOLD_TTL_SECONDS=900
