# =============================================================================
# Production / Render environment template
# Local secrets: .env (gitignored) · copy keys into Render → Environment
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3002
# Public URL after deploy
BASE_URL=https://YOUR-SERVICE.onrender.com
LOG_LEVEL=info
SEED_ON_START=false

# --- Postgres (Supabase) — BOTH must use the pooler from Render (IPv4) ---
# Transaction pooler (app queries) — port 6543
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler (migrations) — port 5432 on the SAME pooler host
# Do NOT use db.YOUR_PROJECT.supabase.co from Render — it often fails with P1001
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- API gate ---
API_KEY=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_ISSUER=shopping-cart
JWT_AUDIENCE=shopping-cart-api

# --- Rate limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_WRITE_MAX=30

# --- Supabase Storage ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
S3_ENDPOINT=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=
STOCK_HOLD_TTL_SECONDS=900
