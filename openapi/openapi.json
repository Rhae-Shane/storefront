    "/api/v1/cart/merge": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Merge Guest Cart Into User Cart",
        "description": "Call explicitly right after login/register. Requires Bearer JWT + guest session (`x-cart-session` or body.sessionToken). Sums quantities on productId collisions, then marks the guest cart ABANDONED.",
        "security": [
          {
            "ApiKeyAuth": [],
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "description": "Optional client-supplied request ID for log correlation. If omitted, the server generates a UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "x-cart-session",
            "in": "header",
            "required": false,
            "description": "Guest cart session token (preferred over body).",
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ],
        "requestBody": {
          "required": false,
